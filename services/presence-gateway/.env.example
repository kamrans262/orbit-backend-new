# Secrets must be loaded from a private environment/secret manager, NEVER Flutter.
NODE_ENV=production
ORBIT_BACKEND_API_ORIGIN=https://api.example.invalid/
ORBIT_GATEWAY_REDIS_URL=rediss://username:password@redis.example.invalid:6380
ORBIT_M9_GATEWAY_SECRET=SET_TO_A_SEPARATE_MINIMUM_32_CHARACTER_SERVER_SECRET
ORBIT_GATEWAY_TLS_CERT_PATH=/run/secrets/fullchain.pem
ORBIT_GATEWAY_TLS_KEY_PATH=/run/secrets/privkey.pem
ORBIT_GATEWAY_BIND_HOST=0.0.0.0
ORBIT_GATEWAY_PORT=8443
ORBIT_GATEWAY_MAX_CLIENTS=2000
ORBIT_GATEWAY_MAX_VIEWER_DEVICES=12
